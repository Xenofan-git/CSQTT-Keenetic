{
  "manifest_version": 3,
  "name": "CSQTT VK CAPTCHA Bridge",
  "version": "0.1.0",
  "description": "Returns VK Smart CAPTCHA success_token to the waiting CSQTT panel session.",
  "content_scripts": [
    {
      "matches": [
        "https://id.vk.com/*",
        "https://id.vk.ru/*"
      ],
      "js": [
        "captcha-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}